# =============================================================================
# Focus — modèle de variables d'environnement (phase M0)
#
#   cp .env.example .env     # puis adapter si nécessaire
#
# `.env` n'est JAMAIS commité (voir .gitignore). Aucune valeur réelle ici.
# Les variables `EXPO_PUBLIC_*` sont embarquées dans le bundle web/mobile :
# n'y placer AUCUN secret.
# Référence : docs/03-DOCUMENTATION-TECHNIQUE.md §4
# =============================================================================

# --- Application / API -------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_ORIGIN=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:4000

# --- PostgreSQL 16 (docker/compose.yml) --------------------------------------
DATABASE_URL=postgresql://focus:focus@localhost:5432/focus_dev?schema=public

# --- Redis 7 (cache, files BullMQ, rate limiting) ----------------------------
REDIS_URL=redis://localhost:6379

# --- Authentification JWT (ADR-010) ------------------------------------------
# Générer une valeur locale : openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-000000000000000000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=focus-api
JWT_AUDIENCE=focus-clients
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# --- Limitation de débit ------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- Stockage objet (MinIO en local) -----------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=focus-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# --- E-mail (MailHog en local) -----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Focus <no-reply@focus.local>"

# --- Notifications ------------------------------------------------------------
EXPO_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Observabilité ------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug

# --- Synchronisation ----------------------------------------------------------
SYNC_RETENTION_DAYS=90

# --- Drapeaux de fonctionnalités (V1.x) --------------------------------------
FEATURE_FLAGS=eisenhower=false,pomodoro=false

# =============================================================================
# Client Expo — apps/mobile/.env (préfixe EXPO_PUBLIC_ obligatoire)
# =============================================================================
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Émulateur Android : remplacer par http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:4000
EXPO_PUBLIC_APP_SCHEME=focus
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_FEATURE_POMODORO=false

# =============================================================================
# Desktop Tauri — V1.1 (les clés de signature ne vivent qu'en CI)
# =============================================================================
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
FOCUS_WEB_URL=http://localhost:8081
