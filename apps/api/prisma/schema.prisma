// Schéma de données — phase M0 (doc 01 §9, doc 03 §5.1).
// Sous-ensemble livré en M0 : identité/sessions, workspace, projet, tâche et
// journal de synchronisation. Les tables des phases ultérieures (tags,
// rappels, habitudes…) seront ajoutées avec le module qui les consomme (O9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceMode {
  FIXED
  AFTER_COMPLETION
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WeekStart {
  MONDAY
  SUNDAY
}

enum TimeFormat {
  H24
  H12
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

// Opération du journal : un `UPDATE` et un `CREATE` produisent tous deux un
// UPSERT côté journal (le client applique l'état complet), une suppression un
// tombstone DELETE (doc 01 §9.3).
enum SyncOperation {
  UPSERT
  DELETE
}

// RF-51 : plateforme d'un appareil enregistré pour les notifications push.
enum DevicePlatform {
  ANDROID
  IOS
  WEB
  DESKTOP
}

// RF-50 : état d'un rappel dans le journal de livraison.
enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model User {
  id              String    @id @db.Uuid
  // `citext` rend l'unicité insensible à la casse sans dépendre du client
  // (RF-01) ; l'extension est créée par la migration initiale.
  email           String    @unique @db.Citext
  passwordHash    String    @db.VarChar(255)
  displayName     String    @db.VarChar(80)
  avatarUrl       String?   @db.VarChar(2048)
  timezone        String    @default("Europe/Paris") @db.VarChar(64)
  locale          String    @default("fr") @db.VarChar(5)
  weekStartsOn    WeekStart @default(MONDAY)
  timeFormat      TimeFormat @default(H24)
  theme           ThemePreference @default(SYSTEM)
  // RF-20 : l'analyse de la saisie rapide reste désactivable.
  quickAddParsingEnabled Boolean @default(true)
  // RF-72 : télémétrie strictement opt-in, désactivée par défaut.
  telemetryEnabled Boolean @default(false)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  // Suppression logique (RF-06) : la purge physique intervient 30 jours plus
  // tard via `pnpm --filter @focus/api db:purge`.
  deletionRequestedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  sessions  Session[]
  devices   Device[]
  exportJobs ExportJob[]
  notificationPreference NotificationPreference?
  passwordResetTokens PasswordResetToken[]
  memberships WorkspaceMember[]
  workspaces  Workspace[] @relation("WorkspaceOwner")

  @@index([deletedAt])
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  // Empreinte SHA-256 du refresh token : la valeur en clair n'est jamais
  // stockée (doc 03 §6.2).
  refreshTokenHash String    @unique @db.VarChar(64)
  // Une famille couvre une chaîne de rotations : présenter un token déjà
  // consommé révoque toute la famille (détection de réutilisation).
  familyId         String    @db.Uuid
  deviceId         String?   @db.Uuid
  // Plateforme déclarée par le client (`X-Client-Platform`) et nom lisible de
  // l'appareil : RF-03/RF-70 affichent ces informations dans les sessions.
  platform         String?   @db.VarChar(20)
  deviceName       String?   @db.VarChar(80)
  userAgent        String?   @db.VarChar(512)
  ip               String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

// Verrouillage progressif après échecs de connexion (RF-01). La clé est
// l'e-mail normalisé : un compte inexistant suit le même chemin, donc la
// latence et le statut ne révèlent pas son existence.
model LoginAttempt {
  email        String    @id @db.Citext
  failedCount  Int       @default(0)
  lockLevel    Int       @default(0)
  lockedUntil  DateTime? @db.Timestamptz(3)
  lastFailedAt DateTime  @default(now()) @db.Timestamptz(3)
}

// Jeton de réinitialisation à usage unique (RF-02) : seule l'empreinte SHA-256
// est stockée ; le lien en clair n'existe que dans l'e-mail.
model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id         String   @id @db.Uuid
  name       String   @db.VarChar(120)
  ownerId    String   @db.Uuid
  isPersonal Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  projects    Project[]
  tasks       Task[]
  tags        Tag[]
  syncChanges SyncChange[]
  reminderDeliveries ReminderDelivery[]

  @@index([ownerId])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  name        String    @db.VarChar(120)
  color       String?   @db.VarChar(32)
  description String?   @db.Text
  sortOrder   Decimal   @default(1) @db.Decimal(30, 15)
  archivedAt  DateTime? @db.Timestamptz(3)
  // Contrôle optimiste et tombstone : mêmes règles que `Task` (RF-10).
  version     Int       @default(0)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId, archivedAt])
  @@index([workspaceId, deletedAt])
}

model Task {
  id              String         @id @db.Uuid
  workspaceId     String         @db.Uuid
  projectId       String?        @db.Uuid
  parentId        String?        @db.Uuid
  title           String         @db.VarChar(200)
  description     String?        @db.Text
  status          TaskStatus     @default(TODO)
  priority        TaskPriority   @default(NONE)
  dueDate         DateTime?      @db.Date
  dueTime         String?        @db.VarChar(5)
  timezone        String         @default("Europe/Paris") @db.VarChar(64)
  completedAt     DateTime?      @db.Timestamptz(3)
  // RF-31 : épingle indépendante de l'échéance, remise à null au désépinglage.
  pinnedAt        DateTime?      @db.Timestamptz(3)
  // Clé de tri fractionnaire (doc 01 §9.3) : insertion entre deux éléments sans
  // réécrire les voisins. Exposée en chaîne décimale à 15 décimales.
  sortOrder       Decimal        @default(1) @db.Decimal(30, 15)
  // RF-34 : position dans la colonne Kanban du projet. Distincte de
  // `sortOrder` pour qu'un déplacement de carte ne réordonne pas la liste
  // manuelle globale ; `null` = jamais déplacée, tri par `sortOrder`.
  boardOrder      Decimal?       @db.Decimal(30, 15)
  recurrenceRule  String?        @db.VarChar(400)
  recurrenceMode  RecurrenceMode @default(FIXED)
  estimateMinutes Int?
  // Le contrat expose `tagIds` ; la table `Tag`/`TaskTag` arrive avec la
  // feature tags (M1). Stocker le tableau ici évite une table morte en M0.
  tagIds          String[]       @db.Uuid
  // RF-21 : date de début et rappels multiples d'une tâche.
  startDate       DateTime?      @db.Date
  reminders       String[]       @default([])
  // RF-50 : décalages relatifs (minutes avant l'échéance), en plus des
  // rappels absolus. Le total `reminders + reminderOffsets` est plafonné à 5.
  reminderOffsets Int[]          @default([])
  version         Int            @default(0)
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?      @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]    @relation("Subtasks")
  reminderDeliveries ReminderDelivery[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, projectId, status, sortOrder])
  @@index([workspaceId, projectId, status, boardOrder])
  @@index([workspaceId, dueDate])
}

model SyncChange {
  id               BigInt        @id @default(autoincrement())
  workspaceId      String        @db.Uuid
  entityType       String        @db.VarChar(32)
  entityId         String        @db.Uuid
  operation        SyncOperation
  version          Int
  payload          Json
  actorId          String?       @db.Uuid
  // Idempotence du push : un même `clientMutationId` rejoué ne produit pas
  // une seconde écriture (doc 03 §6.5).
  clientMutationId String?       @db.Uuid
  changedAt        DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, clientMutationId])
  @@index([workspaceId, id])
}

// RF-26 : tag libre par workspace, unique sans tenir compte de la casse via
// `nameNormalized` (PostgreSQL ne sait pas indexer `lower(name)` avec Prisma).
model Tag {
  id             String   @id @db.Uuid
  workspaceId    String   @db.Uuid
  name           String   @db.VarChar(40)
  nameNormalized String   @db.VarChar(40)
  color          String?  @db.VarChar(32)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

      @@unique([workspaceId, nameNormalized])
  @@index([workspaceId])
}

// RF-51 : un appareil par jeton push, désactivable indépendamment des autres.
// Sans jeton (permission refusée, web sans Web Push), il reste enregistré pour
// que l'utilisateur voie et pilote l'appareil courant.
model Device {
  id                   String         @id @db.Uuid
  userId               String         @db.Uuid
  platform             DevicePlatform
  pushToken            String?        @unique @db.VarChar(255)
  deviceName           String?        @db.VarChar(80)
  notificationsEnabled Boolean        @default(true)
  lastSeenAt           DateTime       @default(now()) @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// RF-71 : file persistante des exports de compte. Le worker réclame une ligne
// PENDING de façon atomique, puis stocke le JSON jusqu'à expiration (24 h).
enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

model ExportJob {
  id          String       @id @db.Uuid
  userId      String       @db.Uuid
  status      ExportStatus @default(PENDING)
  payload     Json?
  error       String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?    @db.Timestamptz(3)
  completedAt DateTime?    @db.Timestamptz(3)
  expiresAt   DateTime?    @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// RF-72 : événements anonymes. Aucune colonne userId/workspaceId/IP : le
// consentement est vérifié avant l'écriture, l'identité n'est jamais stockée.
model TelemetryEvent {
  id         String   @id @db.Uuid
  name       String   @db.VarChar(64)
  properties Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([name, createdAt])
}

// RF-50/RF-51 : préférences de notification, une ligne par utilisateur.
model NotificationPreference {
  userId               String   @id @db.Uuid
  remindersEnabled     Boolean  @default(true)
  dailySummaryEnabled  Boolean  @default(false)
  collaborationEnabled Boolean  @default(true)
  // Plage silencieuse `HH:mm` dans le fuseau de l'utilisateur ; vide = aucune.
  quietHoursStart      String?  @db.VarChar(5)
  quietHoursEnd        String?  @db.VarChar(5)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// RF-50 : journal des rappels planifiés. `jobId` est déterministe
// (`reminder:<taskId>:<triggerAt>`), donc replanifier la même échéance ne crée
// pas de doublon ; `scheduledFor` intègre la plage silencieuse.
model ReminderDelivery {
  id            String         @id @db.Uuid
  workspaceId   String         @db.Uuid
  userId        String         @db.Uuid
  taskId        String         @db.Uuid
  triggerAt     DateTime       @db.Timestamptz(3)
  scheduledFor  DateTime       @db.Timestamptz(3)
  offsetMinutes Int?
  postponed     Boolean        @default(false)
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?      @db.Timestamptz(3)
  jobId         String         @unique @db.VarChar(120)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([taskId, triggerAt])
  @@index([status, scheduledFor])
  @@index([workspaceId, taskId])
}
