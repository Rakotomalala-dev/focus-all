{
  "name": "@focus/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Client Focus — Expo + Expo Router (Android + Web/PWA). Socle M0 sans logique métier.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@focus/design-tokens": "workspace:*",
    "@focus/ui": "workspace:*",
    "@expo/metro-runtime": "~4.0.0",
    "expo": "~52.0.28",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.7.3"
  }
}
