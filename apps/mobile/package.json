{
  "name": "@focus/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Client Focus — Expo + Expo Router (Android + Web/PWA). Liste, création rapide et complétion des tâches (M1).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@focus/contracts": "workspace:*",
    "@focus/design-tokens": "workspace:*",
    "@focus/ui": "workspace:*",
    "@tanstack/react-query": "^5.108.4",
    "axios": "^1.21.1",
    "expo": "~52.0.28",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "i18next": "^25.10.10",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
