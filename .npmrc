# Doc 03 §13.1 : une version de Node hors `engines` doit faire échouer l'installation.
engine-strict=true

# Expo SDK 52 ne supporte pas les dépendances isolées de pnpm (support à partir du
# SDK 54, cf. docs.expo.dev/guides/monorepos) : sans ce linker, Metro ne résout pas
# les dépendances internes d'expo-router ni @babel/runtime.
node-linker=hoisted
